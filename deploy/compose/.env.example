# Copy to `.env` before running `docker compose up -d`.
# Never commit `.env` with real credentials.

# Container image (pin to a released tag@sha256:<digest> in production).
LO_IMAGE=ghcr.io/eimsound/lazy-observe:latest

# Public gateway host binding (defaults to loopback; place behind a TLS reverse proxy).
LO_BIND_ADDR=127.0.0.1
LO_PORT=3100
LO_STANDALONE_PORT=3100
# Public console base URL used for clickable links in alert notifications (empty disables links).
# LO_EXTERNAL_URL=https://observe.example.com

# Resource budgets for the lazy-observe container.
LO_CPU_LIMIT=2.0
LO_MEMORY_LIMIT=2G
LO_CPU_RESERVATION=0.25
LO_MEMORY_RESERVATION=512M

# Global retention settings (maps directly to LO_RETENTION_* in internal/config/config.go).
# In standalone mode metrics/logs/traces retention is passed to the external Victoria services.
LO_RETENTION_METRICS=90d
LO_RETENTION_LOGS=14d
LO_RETENTION_TRACES=7d
LO_RETENTION_REPLAY=3d
LO_RETENTION_SOURCEMAPS=90d
LO_RETENTION_ALERT_EVENTS=30d
LO_RETENTION_PROFILES=7d
LO_RETENTION_ISSUES_CLOSED=true

# Embedded vmagent scraping: "auto" or "disabled".
LO_SCRAPE_MODE=auto

# Self-monitoring through the built-in project.
LO_SELF_MONITORING_ENABLED=true
LO_SELF_MONITORING_PROFILING=false

# Browser security hardening (set true when TLS terminates at a reverse proxy).
LO_SECURITY_SESSION_SECURE_COOKIE=false
# Comma-separated reverse proxy IPs or CIDRs trusted for X-Forwarded-For, e.g. 127.0.0.1,10.0.0.0/8.
LO_SECURITY_TRUSTED_PROXIES=

# Managed child and drain timeouts (must fit inside stop_grace_period: 45s).
LO_PROCESS_STARTUP_TIMEOUT=20s
LO_PROCESS_SHUTDOWN_TIMEOUT=15s
LO_PROCESS_DRAIN_TIMEOUT=20s

# -----------------------------------------------------------------------------
# Standalone / HA profile settings (`docker compose --profile standalone up -d`)
# -----------------------------------------------------------------------------
LO_META_MIGRATION_LOCK_TIMEOUT=60s

LO_PG_USER=lazy_observe
LO_PG_PASSWORD=change-me-postgres
LO_PG_DB=lazy_observe

LO_REDIS_PASSWORD=
LO_REDIS_DB=0
LO_REDIS_KEY_PREFIX=lazy-observe

LO_BLOB_S3_BUCKET=lazy-observe
LO_BLOB_S3_REGION=us-east-1
LO_BLOB_S3_ACCESS_KEY=lazyobserve
LO_BLOB_S3_SECRET_KEY=change-me-s3-secret

# Host paths mounted read-only into lazy-observe-standalone (readable by UID 65532).
# Generate before first start; see deploy/compose/README.md.
LO_SECRET_KEY_HOST_PATH=./secrets/secret.key
LO_ADMIN_PASSWORD_HOST_PATH=./secrets/admin-password
