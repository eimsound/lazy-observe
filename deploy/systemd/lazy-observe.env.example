# Environment overrides for lazy-observe.service.
# Install at /etc/lazy-observe/lazy-observe.env with mode 0640 (root:lazy-observe).
#
# Precedence: CLI flags > LO_* environment variables > config.yaml > defaults.
# Only canonical LO_* names from internal/config/config.go are accepted.
# Key material and passwords never travel via environment variables: pass file paths
# to LO_SECURITY_SECRET_KEY_FILE and LO_SECURITY_ADMIN_PASSWORD_FILE instead.

# Public listen address and persistent data directory.
LO_LISTEN=:3100
LO_DATA_DIR=/var/lib/lazy-observe
# Public console base URL used for clickable links in alert notifications (empty disables links).
# LO_EXTERNAL_URL=https://observe.example.com

# Explicit topology: "", "all-in-one", "standalone", or "ha".
LO_TOPOLOGY=all-in-one

# Browser security hardening (enable when TLS terminates at a reverse proxy).
LO_SECURITY_SESSION_SECURE_COOKIE=false
# LO_SECURITY_TRUSTED_PROXIES=127.0.0.1,::1

# Optional explicit platform encryption key and first admin password files (mode 0600).
# Empty secret_key_file defaults to <data_dir>/secret.key (auto-generated on first boot).
# LO_SECURITY_SECRET_KEY_FILE=/etc/lazy-observe/secret.key
# LO_SECURITY_ADMIN_PASSWORD_FILE=/etc/lazy-observe/admin-password

# Optional external metadata / shared state / blob storage (uncomment for standalone or ha):
# LO_STANDALONE=true
# LO_META_DB_URL=postgres://lazy_observe:change-me@127.0.0.1:5432/lazy_observe?sslmode=require
# LO_META_MIGRATION_LOCK_TIMEOUT=60s
# LO_REDIS_ENABLED=true
# LO_REDIS_ADDR=127.0.0.1:6379
# LO_REDIS_PASSWORD=
# LO_REDIS_DB=0
# LO_REDIS_KEY_PREFIX=lazy-observe
# LO_BLOB_BACKEND=s3
# LO_BLOB_S3_BUCKET=lazy-observe
# LO_BLOB_S3_REGION=us-east-1
# LO_BLOB_S3_ENDPOINT=https://s3.example.com
# LO_BLOB_S3_ACCESS_KEY=
# LO_BLOB_S3_SECRET_KEY=
# LO_STORAGE_METRICS_KIND=vm
# LO_STORAGE_METRICS_QUERY_URL=http://127.0.0.1:8428
# LO_STORAGE_METRICS_INGEST_URL=http://127.0.0.1:8428
# LO_STORAGE_LOGS_URL=http://127.0.0.1:9428
# LO_STORAGE_TRACES_URL=http://127.0.0.1:10428

# Shutdown and drain budgets (must remain below TimeoutStopSec=45s in lazy-observe.service).
LO_PROCESS_STARTUP_TIMEOUT=20s
LO_PROCESS_SHUTDOWN_TIMEOUT=15s
LO_PROCESS_DRAIN_TIMEOUT=20s
