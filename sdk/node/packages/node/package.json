{
  "name": "@lazy-observe/node",
  "version": "0.1.0",
  "description": "Explicit Node.js observability for lazy-observe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "pprof-format": "^2.4.0"
  },
  "peerDependencies": {
    "express": ">=4 <6",
    "pino": ">=9 <11",
    "winston": ">=3 <4",
    "winston-transport": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "winston": {
      "optional": true
    },
    "winston-transport": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "tsdown": "0.23.7",
    "winston": "^3.0.0",
    "winston-transport": "^4.9.0"
  }
}
