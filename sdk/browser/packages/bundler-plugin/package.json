{
  "name": "@lazy-observe/bundler-plugin",
  "version": "0.1.0",
  "description": "Vite plugin and CLI that upload source maps to lazy-observe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lazy-observe-sourcemaps": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "0.23.7"
  }
}
