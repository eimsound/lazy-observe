{
  "name": "@lazy-observe/browser",
  "version": "0.1.0",
  "description": "Framework-independent browser SDK for lazy-observe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "rrweb": "2.2.2",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0"
  }
}
