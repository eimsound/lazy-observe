# Pinned mise bootstrap release, shared by scripts/ci-setup-mise.sh and the Dockerfile
# builder stage. Sourced, not executed: keep it to plain assignments.
#
# sha256 values are the upstream release checksums from SHASUMS256.txt:
#   https://github.com/jdx/mise/releases/download/v2026.5.3/SHASUMS256.txt
# Bump MISE_BOOTSTRAP_VERSION and both checksums together; consumers download the raw
# mise-${MISE_BOOTSTRAP_VERSION}-linux-{x64,arm64} binaries from the same GitHub release.
MISE_BOOTSTRAP_VERSION=v2026.5.3
MISE_BOOTSTRAP_SHA256_AMD64=9a4f228158a316b236653ff615e9955f50c56c6a3ef719135d327c7fc632b89b
MISE_BOOTSTRAP_SHA256_ARM64=602a202118dc7710badace4d60f4de48f3f382b0e2f8d02085a62cd161832917
