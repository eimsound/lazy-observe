# Pinned mise bootstrap release, shared by scripts/ci-setup-mise.sh and the Dockerfile
# builder stage. Sourced, not executed: keep it to plain assignments.
#
# sha256 values are the upstream release checksums from SHASUMS256.txt:
#   https://github.com/jdx/mise/releases/download/v2026.11.7/SHASUMS256.txt
# Renovate bumps all three lines in one PR (.github/renovate.json); the trailing `# <tag>` on each checksum line is
# what lets it sync the digest with the version, so keep it equal to MISE_BOOTSTRAP_VERSION when bumping by hand.
# Consumers download the raw mise-${MISE_BOOTSTRAP_VERSION}-linux-{x64,arm64} binaries from the same GitHub release.
MISE_BOOTSTRAP_VERSION=v2026.11.7
MISE_BOOTSTRAP_SHA256_AMD64=8f5426d9971eaf713b37509749174ca69cf2f08b8b25e389168dcfcab9cd1a4d # v2026.11.7
MISE_BOOTSTRAP_SHA256_ARM64=e4392a51b1b99107b3dd0c8c1b1efa737b614e15950af34921067ce829929af8 # v2026.11.7
